{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "name": "Go",
    "features": {
        // "ghcr.io/devcontainers/features/go:1": {
        //     "version": "1.24"
        // },
        "ghcr.io/devcontainers/features/aws-cli:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:2.12.4": {
            "moby": true
        }

    },
    "customizations": {
        "vscode": {
            "extensions": [
                //"stateful.runme"
            ]
        }
    },
    "workspaceFolder": "${localEnv:HOME}/go/src/github.com/metahub-registry/metahub-api",
    "remoteUser": "root",
    "portsAttributes": {
        "7474": {
            "label": "Neo4j UI",
            "onAutoForward": "notify"
        },
        "9001": {
            "label": "Minio Console",
            "onAutoForward": "notify"
        },
        "16686": {
            "label": "Jaeger UI",
            "onAutoForward": "notify"
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/go/src/github.com/metahub-registry/metahub-api,target=${localEnv:HOME}/go/src/github.com/metahub-registry/metahub-api,type=bind,consistency=cached",
        "source=${localEnv:HOME}/src/gitlab.com/qnib-metahub/community-edition,target=${localEnv:HOME}/src/gitlab.com/qnib-metahub/community-edition,type=bind,consistency=cached",
        "source=${localEnv:HOME}/go/src/github.com/metahub-registry/metahub-admin,target=${localEnv:HOME}/go/src/github.com/metahub-registry/metahub-admin,type=bind,consistency=cached",
        "source=${localEnv:HOME}/go/src/github.com/metahub-registry/metahub-core,target=${localEnv:HOME}/go/src/github.com/metahub-registry/metahub-core,type=bind,consistency=cached",
        "source=${localEnv:HOME}/src/gitlab.com/qnib-frontend/metahub-ui,target=${localEnv:HOME}/src/gitlab.com/qnib-frontend/metahub-ui,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.config/opencode,target=/root/.config/opencode,type=bind,consistency=cached",
        "source=/Users/christian.kniep/.config/openviking/ovcli.conf,target=/Users/christian.kniep/.config/openviking/ovcli.conf,type=bind,consistency=cached",
        "source=${localEnv:HOME}/temp/QnibObsidian,target=${localEnv:HOME}/temp/QnibObsidian,type=bind,consistency=cached"
    ]
}