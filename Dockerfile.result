# syntax=docker/dockerfile:1.4
ARG METALIB_IMAGE
FROM $METALIB_IMAGE AS metalib

FROM harbor.example.com/qnib-container/golang:2026-04-14.1 AS go
#RUN apk add --no-cache build-base gcc git musl-dev

WORKDIR /go/metahub-api
COPY . ./
COPY --from=metalib /pkg exp/metalib/pkg
COPY --from=metalib /go.sum /go.mod exp/metalib/
ENV CGO_ENABLED=1 GOOS=linux
ENV CGO_CFLAGS="-DSQLITE_DISABLE_PREAD -DSQLITE_DISABLE_MREAD"
RUN --mount=type=cache,target=/go/pkg/mod go mod tidy
RUN --mount=type=cache,target=/go/pkg/mod go build -a -ldflags '-extldflags "-static"' .

FROM alpine:3.21 AS gonja
RUN apk add --no-cache wget \
 && wget -qO- https://gitlab.com/qnib-golang/gonja-cli/-/releases/v0.0.2/downloads/gonja-cli_0.0.2_linux_amd64.tar.gz |tar xfz - -C /usr/local/bin

FROM alpine:3.21
ENV METAHUB_API_PORT=80 \
    METAHUB_DB=/var/lib/metahub/metahub.db \
    CFG_FILE=/etc/metahub/api.yaml \
    BLOB_BUCKET=blobs \
    MANIFESTS_BUCKET=manifests

COPY --from=gonja /usr/local/bin/gonja-cli /usr/local/bin/gonja-cli
#RUN mkdir -p /etc/metahub/ \ 
# && apk add --no-cache bash jq py3-pip \
# && pip3 install --break-system-packages wildq==1.0.6
COPY --from=go /go/metahub-api/metahub-api /usr/bin/metahub-api
COPY ./misc/config/metahub-api.yaml ./misc/config/metahub-api.yaml.tpl /opt/metahub-api/
COPY ./metahub.db /var/lib/metahub/metahub.db
VOLUME /var/lib/metahub
VOLUME /etc/metahub/
COPY ./misc/docker/bin/start.sh /usr/local/bin/start.sh
RUN mkdir -p /var/metahub/run/
CMD ["/usr/local/bin/start.sh"]
