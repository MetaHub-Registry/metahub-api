# syntax=docker/dockerfile:1.4
#
# Multi-arch build (linux/amd64 + linux/arm64) — built via buildx:
#   * Every stage that EXECUTES commands is pinned to --platform=$BUILDPLATFORM,
#     so it always runs natively on the build agent (no QEMU for the heavy work).
#   * The Go build cross-compiles for TARGETARCH. cgo (mattn/go-sqlite3) is
#     cross-built with zig cc (alpine package) — no QEMU for the compile either.
#   * The final stage stays unpinned (alpine is multi-arch) so buildkit emits a
#     real per-arch image. Its single RUN (mkdir) is trivial and may run under
#     QEMU for the foreign leg (binfmt installed by the CI build script).
ARG METALIB_IMAGE
# Base image registry, supplied by build-image.sh from HARBOR_REG. Declared in the
# global scope (before the first FROM) so later stages can use it.
ARG BASE_REGISTRY
FROM --platform=$BUILDPLATFORM $METALIB_IMAGE AS metalib

# --- Go build: runs natively on the builder, cross-compiles to TARGETARCH ---
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/golang:1.26-alpine AS go
ARG TARGETOS TARGETARCH
# zig cc serves as the cgo cross-compiler for non-native targets:
#   amd64 -> x86_64-linux-musl, arm64 -> aarch64-linux-musl
RUN apk add --no-cache zig
WORKDIR /go/metahub-api
COPY . ./
COPY --from=metalib /pkg exp/metalib/pkg
COPY --from=metalib /go.sum /go.mod exp/metalib/
ENV CGO_ENABLED=1 GOOS=linux
# -fno-sanitize=undefined: zig cc instruments C with UBSan by default but does
# not link the ubsan runtime as a pure linker (undefined __ubsan_handle_*).
ENV CGO_CFLAGS="-DSQLITE_DISABLE_PREAD -DSQLITE_DISABLE_MREAD -fno-sanitize=undefined"
RUN --mount=type=cache,target=/go/pkg/mod go mod tidy
# The build step needs the same cache mount as the tidy step: `go build -a`
# re-populates the module cache, and regclient's testdata ships `.wh.*` names
# (overlayfs whiteout markers) that overlayfs rejects with EINVAL when extracted
# onto the container's overlay rootfs. The cache backend is a plain volume.
RUN --mount=type=cache,target=/go/pkg/mod case "${TARGETARCH}" in \
      amd64) ZTARGET="x86_64-linux-musl" ;; \
      arm64) ZTARGET="aarch64-linux-musl" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && CC="zig cc -target ${ZTARGET}" \
    CGO_ENABLED=1 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH}" \
    go build -a -ldflags '-extldflags "-static"' .

# --- gonja-cli: fetched for the TARGET arch (fetch runs natively) ----------
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/alpine:3.21 AS gonja
ARG TARGETARCH
RUN apk add --no-cache wget \
 && wget -qO- https://gitlab.com/qnib-golang/gonja-cli/-/releases/v0.0.2/downloads/gonja-cli_0.0.2_linux_${TARGETARCH}.tar.gz |tar xfz - -C /usr/local/bin

# --- runtime (per-arch) ----------------------------------------------------
FROM mirror.gcr.io/library/alpine:3.21
ENV METAHUB_API_PORT=80 \
    METAHUB_DB=/var/lib/metahub/metahub.db \
    CFG_FILE=/etc/metahub/api.yaml \
    BLOB_BUCKET=blobs \
    MANIFESTS_BUCKET=manifests

COPY --from=gonja /usr/local/bin/gonja-cli /usr/local/bin/gonja-cli
#RUN mkdir -p /etc/metahub/ \ 
# && apk add --no-cache bash jq py3-pip \
# && pip3 install --break-system-packages wildq==1.0.6
COPY --from=go /go/metahub-api/metahub-api /usr/bin/metahub-api
COPY ./misc/config/metahub-api.yaml.tpl /opt/metahub-api/
COPY ./metahub.db /var/lib/metahub/metahub.db
VOLUME /var/lib/metahub
VOLUME /etc/metahub/
COPY ./misc/docker/bin/start.sh /usr/local/bin/start.sh
RUN mkdir -p /var/metahub/run/
CMD ["/usr/local/bin/start.sh"]
