# syntax=docker/dockerfile:1.4
FROM golang:1.19.1-alpine3.16 AS go
RUN apk add --no-cache git gcc musl-dev
WORKDIR /go/metahub-api
COPY . ./
RUN go mod tidy
ENV CGO_ENABLED=1 GOOS=linux
RUN go build -a -ldflags '-extldflags "-static"' .

FROM alpine:3.16.2
RUN apk add py3-pip jq bash \
 && pip3 install wildq
ENV METAHUB_API_PORT=80
ENV METAHUB_DB=/var/lib/metahub.db
ENV CFG_FILE=/etc/metahub-api.yaml
ENV CONFIGS_BUCKET=configs \
    LAYERS_BUCKET=layers \
    MANIFESTS_BUCKET=manifests
COPY --from=go /go/metahub-api/metahub-api /usr/bin/metahub-api
COPY ./misc/config/metahub-api.yaml /opt/metahub-api/metahub-api.yaml
COPY ./metahub.db /var/lib/metahub.db
COPY ./misc/docker/bin/start.sh /usr/local/bin/start.sh
CMD ["/usr/local/bin/start.sh"]