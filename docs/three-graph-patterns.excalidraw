    {"type":"text","id":"fix_text","x":50,"y":658,"width":1020,"height":35,"text":"Three EXISTS branches in the query, one per pattern. Each branch matches the specific graph path created by its source.\nListing query (CollectionListingGetByRepoLike) + detail query (ManifestGetByCollectionTag) both updated.","originalText":"Three EXISTS branches in the query, one per pattern. Each branch matches the specific graph path created by its source.\nListing query (CollectionListingGetByRepoLike) + detail query (ManifestGetByCollectionTag) both updated.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":50030,"version":1,"versionNonce":50031,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
