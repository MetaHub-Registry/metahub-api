meta {
  name: pushManifest
  type: http
  seq: 3
}

put {
  url: {{registry}}/v2/{{repo}}/manifests/{{tag}}
  body: file
  auth: inherit
}

headers {
  Content-Type: application/vnd.oci.image.manifest.v1+json
}

body:json {
  {
    "schemaVersion": 2,
    "mediaType": "application/vnd.oci.image.manifest.v1+json",
    "config": {
      "mediaType": "application/vnd.oci.image.config.v1+json",
      "digest": "{{simpleConfigDigest}}",
      "size": {{simpleConfigSize}}
    },
    "layers": [
      {
        "mediaType": "application/vnd.oci.image.layer.v1.tar",
        "digest": "{{alpineLayerDigest}}",
        "size": {{alpineLayerSize}}
      }
    ]
  }
}

body:file {
  file: @file(/Users/christian.kniep/temp/metahub/oci/alpine/manifest.json) @contentType(application/vnd.oci.image.manifest.v1+json)
}

settings {
  encodeUrl: true
  timeout: 0
}
