meta {
  name: pushConfig
  type: http
  seq: 1
}

post {
  url: {{registry}}/v2/{{repo}}/blobs/uploads/?digest={{simpleArm64ConfigDigest}}
  body: file
  auth: inherit
}

params:query {
  digest: {{simpleArm64ConfigDigest}}
}

headers {
  Content-Type: application/octet-stream
  Content-Length: 122
}

body:file {
  file: @file(alpine/singlePostArm64/data/config.json) @contentType(application/json; charset=utf-8)
}

script:post-response {
  const location = res.headers['location'];
  if (location) {
    bru.setVar('layerUploadUrl', location);
  }
}

settings {
  encodeUrl: true
  timeout: 5000
  followRedirects: true
  maxRedirects: 5
}
