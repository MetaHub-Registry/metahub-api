meta {
  name: pushAlpine
  type: http
  seq: 2
}

post {
  url: {{registry}}/v2/{{repo}}/blobs/uploads/?digest={{alpineArm64LayerDigest}}
  body: file
  auth: inherit
}

params:query {
  digest: {{alpineArm64LayerDigest}}
}

headers {
  Content-Type: application/octet-stream
  Content-Length: {{alpineArm64LayerSize}}
}

body:file {
  file: @file(alpine/singlePostArm64/data/alpine-arm64.tar) @contentType(application/x-tar)
}

script:post-response {
  const location = res.headers['location'];
  if (location) {
    bru.setVar('layerUploadUrl', location);
  }
}

settings {
  encodeUrl: true
  timeout: 10000
  followRedirects: true
  maxRedirects: 5
}
