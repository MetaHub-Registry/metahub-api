meta {
  name: headManifest
  type: http
  seq: 4
}

head {
  url: {{registry}}/v2/{{repo}}/manifests/{{alpineAmd64ManifestDigest}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/vnd.oci.image.manifest.v1+json
}

body:json {
  {
    "schemaVersion": 2,
    "mediaType": "application/vnd.oci.image.manifest.v1+json",
    "config": {
      "mediaType": "application/vnd.oci.image.config.v1+json",
      "digest": "{{simpleAmd64ConfigDigest}}",
      "size": {{simpleAmd64ConfigSize}}
    },
    "layers": [
      {
        "mediaType": "application/vnd.oci.image.layer.v1.tar",
        "digest": "{{alpineAmd64LayerDigest}}",
        "size": {{alpineAmd64LayerSize}}
      }
    ]
  }
}

script:post-response {
  // Fetch the Docker-Content-Digest response header
  const length = res.getHeader('content-length');
  
  // Normalize just in case (headers can be undefined)
  if (length) {
    // Store it as an environment or collection variable
    bru.setVar('alpineAmd64ManifestLength', length);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
