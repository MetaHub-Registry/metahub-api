meta {
  name: listRegistryTokens
  type: http
  seq: 10
}

get {
  url: {{registry}}/api/v1/protected/registry-tokens
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:post-response {
  // Authentik app passwords surfaced on the Settings page. Empty
  // list is legitimate — the user may not have minted any yet.
  if (res.status === 401) {
    throw new Error(
      "401 — mhapi_jwt missing or expired. Run godmodeLogin (seq 0).");
  }
  if (res.status !== 200) {
    throw new Error("registry-tokens expected 200, got " +
      res.status);
  }
  if (!Array.isArray(res.body)) {
    throw new Error("registry-tokens response not a list: " +
      JSON.stringify(res.body).slice(0, 200));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
