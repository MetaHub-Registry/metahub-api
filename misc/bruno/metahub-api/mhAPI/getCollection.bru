meta {
  name: getCollection
  type: http
  seq: 6
}

post {
  url: {{registry}}/api/v1/collection
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "repo_name": "{{mhapi_repo_name}}",
    "tag_name": "{{mhapi_tag_name}}",
    "profile": "{{mhapi_profile}}"
  }
}

vars:pre-request {
  mhapi_repo_name: qnib/featuretest
  mhapi_tag_name: latest
  mhapi_profile: generic
}

script:post-response {
  // Powers the CollectionDetail page. Returns:
  //   { collection: { name, tag, manifests: [...] },
  //     repos[], bread_crumbs[] }
  //
  // Each manifest carries digest, media_type, platform, size,
  // content_size, registry, upstream, annotations, profiles[],
  // config, layers[], and (post-surface-cpu-target-ui) cpu_target.
  //
  // Profile filter: when the request body carries a non-empty
  // `profile` field, the server returns only the manifests whose
  // resolved profiles[] includes it (handlers/repos.go::RepoGetOne,
  // change add-collection-detail-profile-filter). This is now
  // symmetric with /api/v1/collections (RepoGetAll). The UI passes
  // its selected profile straight through; no client-side filtering.
  //
  // Alternate body shape (numeric graph IDs):
  //   { "collection_id": 123, "tag_id": 456 }
  // — but those IDs change when the graph is re-imported, so the
  // name-based shape is preferred.
  if (res.status !== 200) {
    throw new Error("collection expected 200, got " + res.status +
      " for " + bru.getVar("mhapi_repo_name") + ":" +
      bru.getVar("mhapi_tag_name"));
  }
  const coll = (res.body && res.body.collection) || {};
  const manifests = coll.manifests || [];
  if (!Array.isArray(manifests)) {
    throw new Error("collection.manifests not an array: " +
      JSON.stringify(coll).slice(0, 200));
  }
  // Soft check: at least one manifest should expose a digest.
  const first = manifests[0];
  if (first && !first.digest) {
    throw new Error("first manifest missing digest: " +
      JSON.stringify(first).slice(0, 200));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # getCollection — POST /api/v1/collection
  
  Returns the leaf collection detail (manifests with config, layers,
  annotations, profiles[], cpu_target).
  
  ## Profile filter (server-side)
  
  The body sends `"profile": "{{mhapi_profile}}"`. Set the
  `mhapi_profile` variable to narrow the returned manifests to those
  served under that profile — the server filters (RepoGetOne,
  add-collection-detail-profile-filter), the UI no longer post-filters.
  An empty or whitespace-only string is treated by the API as no
  profile given (normalizeProfile), so the default returns all; a
  padded label like " cpu#zen2 " is trimmed before matching.
  
  - `mhapi_profile = cpu#zen2`  -> only the zen2 manifest.
  - `mhapi_profile = generic`   -> only the plain images.
  - `mhapi_profile = cpu#none`  -> 200 with `collection.manifests: []`
                                   (NOT 404).
  - `mhapi_profile = ""` (default) -> every manifest pinned to the tag.
  
  `mhapi_profile` is shared with listCollections, so setting it once
  (folder vars / environment / request) filters the whole
  list -> detail chain.
}
