meta {
  name: listProfiles
  type: http
  seq: 3
}

get {
  url: {{registry}}/api/v1/profiles
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  // Powers <ProfileSelector> in the UI. Each entry has
  // {id, name, tag, label, rules[]}. `label` is the wire form
  // (e.g. "cpu#zen2", "generic") used by ProfileSelector to set
  // ?profile=… on the Collections route and by getProfileDetail
  // as the path parameter.
  if (res.status !== 200) {
    throw new Error("profiles expected 200, got " + res.status);
  }
  const profiles = (res.body && res.body.profiles) || [];
  if (!Array.isArray(profiles) || profiles.length === 0) {
    throw new Error("profiles[] empty; expected at least 'generic'");
  }
  // Prefer 'generic' so the chain stays deterministic; fall back
  // to the first entry if 'generic' is absent (e.g. minimal seed).
  const generic = profiles.find(p => p && p.label === "generic");
  const pick = generic || profiles[0];
  if (!pick || !pick.label) {
    throw new Error("first profile has no label: " +
      JSON.stringify(pick).slice(0, 200));
  }
  bru.setVar("mhapi_profile_label", pick.label);
}

settings {
  encodeUrl: true
  timeout: 0
}
