meta {
  name: getSession
  type: http
  seq: 9
}

get {
  url: {{registry}}/api/v1/protected/session
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:post-response {
  // Requires {{mhapi_jwt}} from godmodeLogin (seq 0). UI uses this
  // to render the user menu (login, avatar, id).
  //
  // Known dev gotcha: a god-mode JWT can pass middleware auth but
  // fail to resolve to a real Authentik user record, yielding a
  // 500 with an empty body. That's a server bug (session handler
  // should 404 instead) — log it but don't mask other failures.
  if (res.status === 401) {
    throw new Error(
      "401 — mhapi_jwt missing or expired. Run godmodeLogin (seq 0).");
  }
  if (res.status === 500) {
    throw new Error(
      "500 from /protected/session — likely the god-mode JWT does " +
      "not resolve to a real user. Check metahub-api logs; this is " +
      "an unhandled error path, not a Bruno bug.");
  }
  if (res.status !== 200) {
    throw new Error("session expected 200, got " + res.status);
  }
  const b = res.body || {};
  if (!b.login && !b.id) {
    throw new Error("session payload empty: " +
      JSON.stringify(b).slice(0, 200));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
