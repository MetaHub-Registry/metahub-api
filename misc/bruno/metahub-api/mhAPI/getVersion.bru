meta {
  name: getVersion
  type: http
  seq: 2
}

get {
  url: {{registry}}/api/v1/version
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  // Both fields always present. Empty strings are legitimate for
  // older builds that predate the handler — the UI footer falls
  // back to an em-dash. The GoCD verify-ce job uses this to confirm
  // a deploy landed before running behaviour tests.
  if (res.status !== 200) {
    throw new Error("version expected 200, got " + res.status);
  }
  const b = res.body || {};
  if (typeof b.api !== "string" || typeof b.metalib !== "string") {
    throw new Error("version malformed: " +
      JSON.stringify(b).slice(0, 200));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
