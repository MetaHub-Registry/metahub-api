meta {
  name: listCollections
  type: http
  seq: 5
}

post {
  url: {{registry}}/api/v1/collections
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{repo}}"
  }
}

script:post-response {
  // Mirrors fetchCollections() in metahub-ui/src/lib/api.ts.
  //
  // Response shape (see CollectionListResponse in api.ts):
  //   { next: { <slug>: { repo, tag, collection_id, tag_id,
  //                       collection_count, manifest_count } },
  //     bread_crumbs: [...], slug_end, repos[] }
  //
  // `next` is a map keyed by the next path segment. An entry with
  // `tag != ""` is a LEAF (collection-with-tag); `tag == ""` means
  // it's an intermediate folder requiring further drill-down.
  //
  // Optional `profile` filter — uncomment to narrow results so the
  // server hides manifests whose profile rules don't match:
  //
  //   { "repo": "{{repo}}", "profile": "cpu#zen2" }
  //
  if (res.status !== 200) {
    throw new Error("collections expected 200, got " + res.status);
  }
  const next = (res.body && res.body.next) || {};
  const entries = Object.values(next);
  if (entries.length === 0) {
    throw new Error("next{} empty for repo=" + bru.getVar("repo"));
  }
  // Prefer a leaf (entry with a real tag) so step 6 can resolve a
  // collection. Fall back to the first entry if no leaves are
  // present at this depth (caller must drill deeper).
  const leaf = entries.find(e => e && e.tag && e.tag !== "");
  if (!leaf) {
    throw new Error("no leaf entry (tag != \"\") under repo=" +
      bru.getVar("repo") + "; drill deeper. Entries: " +
      JSON.stringify(entries.map(e => e.repo)).slice(0, 200));
  }
  bru.setVar("mhapi_repo_name", leaf.repo);
  bru.setVar("mhapi_tag_name", leaf.tag);
}

settings {
  encodeUrl: true
  timeout: 0
}
