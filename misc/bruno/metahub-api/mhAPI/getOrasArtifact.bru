meta {
  name: getOrasArtifact
  type: http
  seq: 8
}

get {
  url: {{registry}}/api/v1/oras/artifact?repo={{oras_repo}}&artifact_type={{oras_artifact_type}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  // Single ORAS artifact detail. 404 is legitimate when the seed
  // hasn't been pushed; the UI handles it with an empty state.
  if (res.status === 404) {
    return; // expected when oras seed absent
  }
  if (res.status !== 200) {
    throw new Error("oras/artifact expected 200/404, got " +
      res.status);
  }
  const b = res.body || {};
  if (!b.artifact) {
    throw new Error("oras/artifact missing artifact: " +
      JSON.stringify(b).slice(0, 200));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
