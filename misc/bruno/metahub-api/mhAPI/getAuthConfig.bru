meta {
  name: getAuthConfig
  type: http
  seq: 1
}

get {
  url: {{registry}}/api/v1/auth/config
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  // Public discovery endpoint. The UI's Login page calls this to
  // decide whether to render the OIDC button, the god-mode form, or
  // both. Schema: { oidc_enabled: bool, godmode_enabled: bool }.
  if (res.status !== 200) {
    throw new Error("auth/config expected 200, got " + res.status);
  }
  const b = res.body || {};
  if (typeof b.oidc_enabled !== "boolean" ||
      typeof b.godmode_enabled !== "boolean") {
    throw new Error("auth/config malformed: " +
      JSON.stringify(b).slice(0, 200));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
