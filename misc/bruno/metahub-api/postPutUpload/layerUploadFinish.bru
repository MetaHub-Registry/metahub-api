meta {
  name: layerUploadFinish
  type: http
  seq: 2
}

put {
  url: {{registry}}{{layerUploadUrl}}?digest={{layerDigest}}
  body: file
  auth: inherit
}

params:query {
  digest: {{layerDigest}}
}

headers {
  Content-Type: application/octet-stream
  Content-Length: 8816640
}

body:file {
  file: @file(/Users/christian.kniep/temp/metahub/oci/alpine/alpine.tar) @contentType(application/x-tar)
}

settings {
  encodeUrl: true
  timeout: 0
}
