meta {
  name: layerUploadStart
  type: http
  seq: 1
}

post {
  url: {{registry}}/v2/{{repo}}/blobs/uploads/
  body: none
  auth: inherit
}

script:post-response {
  const location = res.headers['location'];
  if (location) {
    bru.setVar('layerUploadUrl', location);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
