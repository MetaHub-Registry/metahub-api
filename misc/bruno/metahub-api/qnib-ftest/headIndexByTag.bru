meta {
  name: headIndexByTag
  type: http
  seq: 2
}

head {
  url: {{registry}}/v2/{{repo}}/manifests/{{tag}}
  body: none
  auth: inherit
}

headers {
  Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json
}

script:post-response {
  if (res.status !== 200) {
    throw new Error("HEAD " + req.url + " expected 200, got " + res.status);
  }
  const ct = res.headers["content-type"] || res.headers["Content-Type"];
  if (!ct || !/image\.index|manifest\.list/.test(ct)) {
    throw new Error("Content-Type is not an image-index: " + ct);
  }
  // Persist the announced digest for later getIndexByDigest round-trip.
  const dig = res.headers["docker-content-digest"] || res.headers["Docker-Content-Digest"];
  if (dig) bru.setVar("indexDigest", dig);
}

settings {
  encodeUrl: true
  timeout: 0
}
