meta {
  name: getIndexByDigest
  type: http
  seq: 4
}

get {
  url: {{registry}}/v2/{{repo}}/manifests/{{indexDigest}}
  body: none
  auth: inherit
}

headers {
  Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json
}

script:post-response {
  if (res.status !== 200) {
    throw new Error("GET by digest " + req.url + " expected 200, got " + res.status);
  }
  if (!res.body || !res.body.manifests) {
    throw new Error("By-digest fetch returned non-index body");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
