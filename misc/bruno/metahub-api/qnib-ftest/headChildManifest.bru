meta {
  name: headChildManifest
  type: http
  seq: 5
}

head {
  url: {{registry}}/v2/{{repo}}/manifests/{{childManifestDigest}}
  body: none
  auth: inherit
}

headers {
  Accept: application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json
}

script:post-response {
  if (res.status !== 200) {
    throw new Error("HEAD " + req.url + " expected 200, got " + res.status);
  }
  // Cross-check that the content-length header matches the size
  // declared in the parent Index descriptor. Mismatch is the
  // symptom that the metalib Minio.NewManifestFromBytes Size-bug
  // (fixed in aefa27f) used to produce: indexes advertised
  // Config.Size where manifest bytes were smaller.
  const announced = res.headers["content-length"] || res.headers["Content-Length"];
  const expected = bru.getVar("childManifestSize");
  if (announced && expected && String(announced) !== String(expected)) {
    throw new Error(
      "Size mismatch: Index descriptor says size=" + expected +
      " but manifest body is " + announced + " bytes " +
      "(regression of metalib aefa27f?)"
    );
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
