meta {
  name: getConfigBlob
  type: http
  seq: 7
}

get {
  url: {{registry}}/v2/{{repo}}/blobs/{{configDigest}}
  body: none
  auth: inherit
}

headers {
  Accept: application/vnd.docker.container.image.v1+json, application/vnd.oci.image.config.v1+json
}

script:post-response {
  if (res.status !== 200) {
    throw new Error("GET config blob " + req.url + " expected 200, got " + res.status + "; this is the symptom of the pipeline admin/api bucket-drift (cab4cf7 fix)");
  }
  // The config is a JSON blob. Parse sanity-check.
  if (!res.body || typeof res.body !== "object") {
    throw new Error("config body not JSON: " + String(res.body).slice(0, 200));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
