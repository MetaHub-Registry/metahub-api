auth {
  mode: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

vars:pre-request {
  profile: generic
}

docs {
  # metahub-api bruno collection

  ## Collection-level variables

  - `profile` (default: `generic`): which metahub profile the OCI
    /v2 requests should resolve against. Used by the qnib-ftest
    folder's `refreshToken.bru` to build the Basic-auth username
    (`{{username}}/{{profile}}` when non-generic). Override per
    request by setting `profile` in a folder's `vars:pre-request`
    or per-environment.

    Examples:
      profile: generic        (default, always works)
      profile: glow#1.5.0     (glow layer applied)
      profile: cpu#zen2       (microarch variant)

    Metahub uses `#` as the profile tag separator, NOT `:`, because
    Basic auth splits on `:` to separate username from password.
}
