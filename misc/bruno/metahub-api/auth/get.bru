meta {
  name: get
  type: http
  seq: 1
}

get {
  url: {{registry}}/v2
  body: none
  auth: none
}

script:post-response {
  const h = res.headers["www-authenticate"] || res.headers["WWW-Authenticate"];
  if (!h) throw new Error("No WWW-Authenticate header; registry might not require Bearer auth.");
  
  if (!h.toLowerCase().startsWith("bearer ")) {
    throw new Error("Not a Bearer challenge: " + h);
  }
  
  const params = {};
  h.replace(/^Bearer\s+/i, "")
   .split(/,\s*/)
   .forEach(kv => {
     const m = kv.match(/^(\w+)="(.*)"$/);
     if (m) params[m[1]] = m[2];
   });
  
  bru.setVar("oci_realm", params.realm);
  bru.setVar("oci_service", params.service);
  bru.setVar("oci_scope", params.scope); // may be undefined for /v2/
}

settings {
  encodeUrl: true
  timeout: 0
}
