meta {
  name: manifest
  type: http
  seq: 1
}

get {
  url: {{registry}}/v2/{{repo}}/manifests/{{tag}}
  body: none
  auth: inherit
}

script:post-response {
  const body = res.getBody();              // usually a string
  const json = typeof body === 'string'
    ? JSON.parse(body)
    : body;                                // sometimes already an object
  
  // Example: response = { "token": { "access_token": "abc" } }
  const configDigest = json.config?.digest;
  
  if (!configDigest) {
    throw new Error("config.digest not found in response body");
  }
  
  // Set as a variable you can use in next requests
  bru.setVar("configDigest", configDigest);
}

settings {
  encodeUrl: true
  timeout: 0
}
